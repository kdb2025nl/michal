# Copy to .env and fill in. NEVER commit .env.
FAL_KEY=
PORT=4377
# Spend cap per project in USD (paid Fal calls are refused above this)
MAX_SPEND_USD=2.00
# Max retries per paid call / stage
MAX_RETRIES=2
# Max automatic render+QA repair attempts
MAX_RENDER_ATTEMPTS=2
# Optional overrides
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PYTHON=py

# --- Hosted / Docker use only ---
# HOST=0.0.0.0            # listen on all interfaces (server REFUSES to start without APP_PASSWORD)
# APP_PASSWORD=change-me  # shared password (HTTP basic auth, any username); protects your FAL_KEY
# PROJECTS_DIR=/data/projects   # mount a persistent volume here
